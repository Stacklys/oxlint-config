{
  "name": "@stacklys/oxlint-config",
  "version": "1.0.1",
  "description": "📦️ High-performance, zero-config linting and formatting configuration powered by Oxlint.",
  "keywords": [
    "clean-code",
    "git",
    "github",
    "starter-ts",
    "typescript",
    "zero-config"
  ],
  "homepage": "https://github.com/Stacklys/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/Stacklys/oxlint-config/issues"
  },
  "author": "Luis Monsalve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stacklys/oxlint-config.git"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "bunx gitlys init",
    "dev": "tsdown --watch",
    "build": "bun run type:check && bun run lint && bun run format && tsdown",
    "type:check": "tsc --noEmit",
    "lint": "oxlint --fix --cache",
    "format": "oxfmt",
    "security:audit": "bun audit",
    "inspector": "bunx oxlint-config-inspector dev",
    "release": "bun run build && bunx gitlys release",
    "publish": "npm publish"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "devDependencies": {
    "@stacklys/tsconfig": "1.0.0",
    "@types/node": "26.6.5",
    "astro": "7.4.2",
    "gitlys": "2.2.4",
    "globals": "17.13.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.17.0"
  }
}