{
  "name": "starter-ts",
  "description": "📦️ Zero-config TypeScript template for rapid development. Pre-configured with modern tooling to start coding",
  "author": "Luis Monsalve",
  "version": "0.0.0",
  "homepage": "https://github.com/TheElegantCoding/starter-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheElegantCoding/starter-ts.git"
  },
  "keywords": [
    "typescript",
    "github",
    "git",
    "clean-code",
    "starter-ts",
    "zero-config"
  ],
  "bugs": {
    "url": "https://github.com/TheElegantCoding/starter-ts/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["./dist"],
  "engines": {
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "postinstall": "bunx gitlys init",
    "dev": "tsup --watch",
    "build": "bun run type:check && bun run lint && tsup",
    "type:check": "tsc --noEmit",
    "lint": "eslint . --fix --cache",
    "security:audit": "bun audit",
    "release": "bun run build && bunx gitlys release"
  },
  "devDependencies": {
    "eslint-config-universal-code": "^1.1.4",
    "gitlys": "^2.2.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}